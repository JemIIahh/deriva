# Copy this file to .env (git-ignored) and fill in the values there. Never commit .env, never paste a value into chat.

# Hugging Face token with write access (docs/runtime.md, section 1): downloads the gated Tiny Aya models and saves
# results to the private workspace repo.
HF_TOKEN=

# The paid judge, an anthropic:<model-id> judge (scripts/run_eval.py --judge). Optional and supplied LAST, with a
# spend cap set by the owner. The stand-in judge (hf:<model-id>, on the GPU runtime) needs no key.
ANTHROPIC_API_KEY=

# Kaggle command-line access: put in whichever form the Kaggle settings page gives you (docs/runtime.md, section 1).
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_API_TOKEN=

# The translator 'llm-chat' of scripts/build_testset.py (src/msd/testset.py): an OpenAI-compatible chat-completions
# endpoint. The test-set build needs it for the Hinglish translation and for the back-translation check of all four
# non-English languages (docs/RUNBOOK.md, step 2). Which model and service is the owner's choice. The code reads these
# three from the process environment only, so load .env into the shell first: set -a; . ./.env; set +a
# The base URL, without the trailing /chat/completions (the code adds it), for example https://<host>/v1
MSD_TRANSLATE_BASE_URL=
# The model name that endpoint expects
MSD_TRANSLATE_MODEL=
# The key for that endpoint (sent as "Authorization: Bearer <key>")
MSD_TRANSLATE_API_KEY=
